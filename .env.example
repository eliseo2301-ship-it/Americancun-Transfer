# ========================================================
# AMERICANCUN TRANSFER - ENVIRONMENT CONFIGURATION
# ========================================================

# Base application URL
NEXT_PUBLIC_APP_URL=https://americancun-transfer.onrender.com
PORT=3000
NODE_ENV=production

# Database (PostgreSQL for Render or Prisma Accelerate)
# For local dev, a postgres or sqlite connection string
DATABASE_URL="postgresql://americancun_user:secret@localhost:5432/americancun_db?schema=public"

# SPEI Bank Transfer Details (Automated Payment Vouchers)
NEXT_PUBLIC_BANK_NAME="BBVA México"
NEXT_PUBLIC_BANK_BENEFICIARY="Americancun Transfer S.A. de C.V."
NEXT_PUBLIC_BANK_CLABE="012691001234567890"
NEXT_PUBLIC_BANK_ACCOUNT="1234567890"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+529981234567"

# WhatsApp Automated Messaging & 60-Minute Alarm Service
# Option A: Meta Cloud API (Official WhatsApp Business API)
META_WA_PHONE_NUMBER_ID=100000000000000
META_WA_ACCESS_TOKEN=EAAG...
META_WA_TEMPLATE_ALARM=transfer_reminder_60min

# Option B: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Scheduler & Background Worker Security
WORKER_SECRET_KEY=americancun_scheduler_secret_token_2026
ALARM_INTERVAL_CRON="*/5 * * * *" # Every 5 minutes checks for rides starting in 60 mins

# Currency exchange rate fallback (USD to MXN)
USD_MXN_EXCHANGE_RATE=18.50
